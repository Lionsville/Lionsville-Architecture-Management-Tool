{
  "name": "lionsville-architecture-management-tool",
  "private": true,
  "version": "0.0.0",
  "description": "Layer-7 application landscapes and the C4 container diagrams under them.",
  "author": "Lionsville Group BV <info@lionsville.nl>",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/Lionsville/Lionsville-Architecture-Management-Tool",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:desktop": "electron-vite build",
    "check": "npm run typecheck && vitest run && npm run lint",
    "check:all": "npm run check && npm run build",
    "dev": "vite",
    "dev:desktop": "electron-vite dev",
    "dist:desktop": "electron-vite build && electron-builder",
    "lint": "eslint src electron build",
    "pack:desktop": "electron-vite build && electron-builder --dir",
    "preview": "vite preview --port 4180 --host 127.0.0.1",
    "setup": "npm install",
    "smoke": "node scripts/verify.mjs smoke",
    "smoke:desktop": "npm run smoke",
    "smoke:run": "electron . --smoke",
    "start:desktop": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@eslint/js": "^10.0.1",
    "@mui/material": "^6.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.3.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "elkjs": "^0.9.3",
    "eslint": "^10.10.0",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "jsdom": "^26.1.0",
    "libavoid-js": "0.4.5",
    "mermaid": "^11.17.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "16.29.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "main": "out/main/index.cjs"
}
