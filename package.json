{
  "name": "lionsville-architecture-management-tool",
  "productName": "Lionsville Architect",
  "private": true,
  "version": "0.0.0",
  "description": "Layer-7 application landscapes and the C4 container diagrams under them.",
  "author": "Lionsville Group BV <info@lionsville.nl>",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/Lionsville/Lionsville-Architecture-Management-Tool",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:desktop": "electron-vite build",
    "check": "npm run typecheck && npm run test:coverage && npm run coverage && npm run lint",
    "check:all": "npm run check && npm run build",
    "coverage": "node --experimental-strip-types build/coverage.ts",
    "deps": "node build/dependencies.ts",
    "dev": "vite",
    "dev:desktop": "electron-vite dev",
    "dist:desktop": "electron-vite build && electron-builder",
    "lint": "eslint src electron build",
    "pack:desktop": "electron-vite build && electron-builder --dir",
    "preview": "vite preview --port 4180 --host 127.0.0.1",
    "setup": "npm install && node scripts/installHooks.mjs",
    "smoke": "node scripts/verify.mjs smoke",
    "smoke:desktop": "npm run smoke",
    "smoke:run": "node build/fresh.ts out src electron index.html package-lock.json vite.config.ts electron.vite.config.ts && electron . --smoke",
    "start:desktop": "electron-vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@mui/material": "^9.4.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.2",
    "@xyflow/react": "^12.12.0",
    "axe-core": "^4.13.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "elkjs": "^0.12.0",
    "eslint": "^10.11.0",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "jsdom": "^29.1.1",
    "libavoid-js": "0.4.5",
    "mermaid": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "16.32.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  },
  "main": "out/main/index.cjs",
  "overrides": {
    "mermaid": {
      "elkjs": "$elkjs"
    },
    "lodash-es": "^4.18.1"
  }
}
