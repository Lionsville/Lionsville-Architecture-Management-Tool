{
  "formatVersion": "1",
  "design": {
    "name": "Acme Logistics",
    "description": "A parcel and pallet operator: order to delivery, the warehouse under it, and what it bills."
  },
  "elements": [
    {
      "key": "order-management",
      "kind": "application",
      "name": "Order Management",
      "category": "Order to delivery",
      "lifecycle": "live",
      "isManaged": true,
      "description": "The order of record from booking to invoice hand-off. Everything downstream reads its status.",
      "iconType": "erp",
      "aspects": {
        "monitoring": {
          "status": "managed"
        },
        "security": {
          "status": "managed"
        },
        "self-healing": {
          "status": "partial"
        },
        "dr": {
          "status": "managed"
        }
      }
    },
    {
      "key": "route-optimiser",
      "kind": "application",
      "name": "Route Optimiser",
      "category": "Order to delivery",
      "lifecycle": "live",
      "isManaged": true,
      "description": "Turns tomorrow’s orders into runs. Solves overnight; a re-solve during the day is manual.",
      "iconType": "planning",
      "aspects": {
        "monitoring": {
          "status": "partial"
        },
        "self-healing": {
          "status": "none",
          "note": "A failed overnight solve is noticed by the planner, not by a monitor."
        },
        "security": {
          "status": "managed"
        },
        "dr": {
          "status": "partial"
        }
      }
    },
    {
      "key": "dispatch",
      "kind": "application",
      "name": "Dispatch",
      "category": "Order to delivery",
      "lifecycle": "live",
      "isManaged": true,
      "description": "The live picture: who is driving what, and what has gone wrong since the plan was made.",
      "iconType": "dashboard",
      "aspects": {
        "monitoring": {
          "status": "managed"
        },
        "self-healing": {
          "status": "partial"
        },
        "security": {
          "status": "managed"
        },
        "dr": {
          "status": "partial"
        }
      }
    },
    {
      "key": "track-trace",
      "kind": "application",
      "name": "Track & Trace",
      "category": "Order to delivery",
      "lifecycle": "live",
      "isManaged": true,
      "description": "Shipment status for customers and support, assembled from scans and driver events.",
      "iconType": "map",
      "aspects": {
        "monitoring": {
          "status": "managed"
        },
        "security": {
          "status": "partial"
        },
        "self-healing": {
          "status": "managed"
        },
        "dr": {
          "status": "managed"
        }
      }
    },
    {
      "key": "planner",
      "kind": "actor",
      "name": "Transport planner",
      "description": "Builds the daily plan: which load goes on which run, and when."
    },
    {
      "key": "dispatcher",
      "kind": "actor",
      "name": "Dispatcher",
      "description": "Runs the day as it actually happens — reassigns, reroutes, explains."
    },
    {
      "key": "warehouse-lead",
      "kind": "actor",
      "name": "Warehouse lead",
      "description": "Owns the floor: labour, dock doors, and what ships tonight."
    },
    {
      "key": "support-agent",
      "kind": "actor",
      "name": "Support agent",
      "description": "Answers \"where is my shipment\", and fixes what caused the question."
    },
    {
      "key": "driver-app",
      "kind": "inputChannel",
      "name": "Driver app",
      "description": "Run sheet, proof of delivery, exceptions. Offline for hours at a time.",
      "iconType": "mobile-app"
    },
    {
      "key": "customer-portal",
      "kind": "inputChannel",
      "name": "Customer portal",
      "description": "Booking, documents and track & trace for contract customers.",
      "iconType": "portal"
    },
    {
      "key": "edi-intake",
      "kind": "inputChannel",
      "name": "EDI intake",
      "description": "Orders from customers who will never use a portal. Mostly EDIFACT.",
      "iconType": "connector"
    },
    {
      "key": "scanners",
      "kind": "inputChannel",
      "name": "Handheld scanners",
      "description": "Every scan in the warehouse and at the dock door.",
      "iconType": "iot-sensor"
    },
    {
      "key": "wms",
      "kind": "application",
      "name": "Warehouse Management",
      "category": "Warehouse",
      "lifecycle": "live",
      "isManaged": true,
      "description": "Stock, tasks and dock doors across three sites. The floor stops when it stops.",
      "iconType": "storage",
      "aspects": {
        "monitoring": {
          "status": "managed"
        },
        "security": {
          "status": "managed"
        },
        "self-healing": {
          "status": "partial"
        },
        "dr": {
          "status": "atRisk",
          "note": "Failover has never been rehearsed against a full shift."
        }
      }
    },
    {
      "key": "slotting",
      "kind": "application",
      "name": "Slotting & Replenishment",
      "category": "Warehouse",
      "lifecycle": "live",
      "isManaged": true,
      "description": "Decides where stock lives and when to move it forward. Reads WMS, writes tasks back.",
      "iconType": "batch-job",
      "aspects": {
        "monitoring": {
          "status": "partial"
        },
        "security": {
          "status": "managed"
        }
      }
    },
    {
      "key": "yard",
      "kind": "application",
      "name": "Yard Management",
      "category": "Warehouse",
      "lifecycle": "planned",
      "isManaged": true,
      "description": "Trailers, doors and time slots on the yard. Bought in, lightly integrated.",
      "iconType": "scheduler",
      "aspects": {
        "monitoring": {
          "status": "none"
        },
        "security": {
          "status": "partial"
        }
      }
    },
    {
      "key": "billing",
      "kind": "application",
      "name": "Billing",
      "category": "Billing",
      "lifecycle": "live",
      "isManaged": true,
      "description": "Invoices what was delivered, from the order and the tariff that applied on the day.",
      "iconType": "finance",
      "aspects": {
        "monitoring": {
          "status": "managed"
        },
        "security": {
          "status": "managed"
        },
        "dr": {
          "status": "managed"
        },
        "self-healing": {
          "status": "partial"
        }
      }
    },
    {
      "key": "tariff-engine",
      "kind": "application",
      "name": "Tariff Engine",
      "category": "Billing",
      "lifecycle": "live",
      "isManaged": true,
      "description": "Contract rates, surcharges and fuel indexation. Changes here move real money.",
      "iconType": "workflow",
      "aspects": {
        "monitoring": {
          "status": "partial"
        },
        "security": {
          "status": "managed"
        },
        "dr": {
          "status": "partial"
        }
      }
    },
    {
      "key": "legacy-rating",
      "kind": "application",
      "name": "Rating (legacy)",
      "category": "Billing",
      "lifecycle": "retiring",
      "isManaged": false,
      "description": "The rating rules the tariff engine has not absorbed yet. Two customers still price here.",
      "iconType": "mainframe",
      "aspects": {
        "monitoring": {
          "status": "none"
        },
        "security": {
          "status": "atRisk",
          "note": "Runs on an OS release that stopped receiving patches."
        },
        "dr": {
          "status": "none"
        }
      }
    },
    {
      "key": "customer-master",
